# =========================================================
# PDF Remaster_v1_0_0 - .gitignore
# Python + Windows + local OCR/SR tooling (weights/logs/output)
# =========================================================

# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.ipynb_checkpoints/

# ---- Virtual environments ----
.venv/
venv/
ENV/
env/
pip-wheel-metadata/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS / Windows ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Logs / debug dumps ----
logs/
*.log
*.trace
*.dmp

# ---- Local app settings / user-specific configs ----
# (keep sample/default configs under version control if you have them)
*__settings__*.json
*_settings*.json
settings.local.json
config.local.json

# ---- Model weights / large assets that are downloaded at runtime ----
# (avoid huge commits and license issues)
weights/
models/
checkpoints/
*.pth
*.pt
*.ckpt
*.onnx

# ---- Outputs / generated files ----
# PDFs
output/
outputs/
out/
*.pdf

# Images / temp render outputs
*.png
*.jpg
*.jpeg
*.webp
*.tif
*.tiff

# Temporary / intermediate files
tmp/
temp/
*.tmp
*.bak
*.old

# ---- Packaging / build artifacts (PyInstaller etc.) ----
build/
dist/
*.spec

# ---- Optional: downloaded archives ----
*.zip
*.7z
